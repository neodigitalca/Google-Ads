{
  "keyword": "posts-ctr-rescue",
  "name": "Posts CTR Rescue",
  "description": "Full AISEO on blog posts when click-through rate falls.",
  "notes": [
    "Polls Google Search Console every 24 hours.",
    "Scope: blog posts (Posts bucket).",
    "Runs when click-through rate fell at least 15% vs the prior 28 days (similar visibility, fewer clicks), with at least 100 impressions.",
    "NEO Pulse rewrites title, meta, headings, and body when the snippet underperforms.",
    "Same URL waits 72 hours before it can run again."
  ],
  "category": "reactive",
  "verticals": [
    "editorial",
    "general"
  ],
  "tags": [
    "gsc",
    "posts",
    "ctr"
  ],
  "prerequisites": [
    "gsc",
    "wordpress"
  ],
  "filters": {
    "executionKinds": [
      "content_optimizer"
    ],
    "targetBuckets": [
      "posts"
    ],
    "triggerSignals": [
      "ctr_drop"
    ],
    "actionCount": 1
  },
  "defaultTasks": [
    {
      "keyword": "posts-ctr",
      "title": "Full AISEO on posts when CTR drops",
      "status": "todo",
      "assignPulse": true,
      "scheduleMode": "trigger",
      "executionKind": "content_optimizer",
      "executionPayload": {
        "targetBucket": "posts",
        "updateMode": "update"
      },
      "triggerConfig": {
        "sources": [
          "gsc"
        ],
        "match": "any",
        "conditions": [
          {
            "signal": "ctr_drop",
            "operator": "gte",
            "value": 15,
            "minImpressions": 100
          }
        ],
        "lookbackDays": 28,
        "compareDays": 28,
        "pollHours": 24,
        "cooldownHours": 72,
        "maxUrls": 5
      }
    }
  ],
  "triggerBlock": {
    "keyword": "gsc-ctr-drop",
    "kind": "gsc",
    "source": "gsc",
    "targetBucket": "posts",
    "triggerConfig": {
      "sources": [
        "gsc"
      ],
      "match": "any",
      "conditions": [
        {
          "signal": "ctr_drop",
          "operator": "gte",
          "value": 15,
          "minImpressions": 100
        }
      ],
      "lookbackDays": 28,
      "compareDays": 28,
      "pollHours": 24,
      "cooldownHours": 72,
      "maxUrls": 5
    }
  },
  "actionBlock": {
    "keyword": "content-optimizer-full",
    "executionKind": "content_optimizer",
    "executionPayload": {
      "targetBucket": "posts",
      "updateMode": "update"
    },
    "title": "Full AISEO on posts when CTR drops"
  },
  "isAutomation": true,
  "kind": "template"
}
