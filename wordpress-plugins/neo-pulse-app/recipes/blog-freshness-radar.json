{
  "keyword": "blog-freshness-radar",
  "name": "Blog Freshness Radar",
  "description": "Full AISEO on blog posts when total search clicks decline.",
  "notes": [
    "Polls Google Search Console every 24 hours.",
    "Scope: blog posts (Posts bucket).",
    "Runs when total clicks from google search fell at least 20% vs the prior 28 days, with at least 150 impressions.",
    "Higher click-drop threshold (20%) for noisier post-level GSC data.",
    "Same URL waits 72 hours before it can run again."
  ],
  "category": "maintenance",
  "verticals": [
    "editorial"
  ],
  "tags": [
    "gsc",
    "posts",
    "clicks",
    "blog"
  ],
  "prerequisites": [
    "gsc",
    "wordpress"
  ],
  "filters": {
    "executionKinds": [
      "content_optimizer"
    ],
    "targetBuckets": [
      "posts"
    ],
    "triggerSignals": [
      "clicks_drop"
    ],
    "actionCount": 1
  },
  "defaultTasks": [
    {
      "keyword": "blog-freshness",
      "title": "Refresh blog posts on clicks drop",
      "status": "todo",
      "assignPulse": true,
      "scheduleMode": "trigger",
      "executionKind": "content_optimizer",
      "executionPayload": {
        "targetBucket": "posts",
        "updateMode": "update"
      },
      "triggerConfig": {
        "sources": [
          "gsc"
        ],
        "match": "any",
        "conditions": [
          {
            "signal": "clicks_drop",
            "operator": "gte",
            "value": 20,
            "minImpressions": 150
          }
        ],
        "lookbackDays": 28,
        "compareDays": 28,
        "pollHours": 24,
        "cooldownHours": 72,
        "maxUrls": 5
      }
    }
  ],
  "triggerBlock": {
    "keyword": "gsc-clicks-drop",
    "kind": "gsc",
    "source": "gsc",
    "targetBucket": "posts",
    "triggerConfig": {
      "sources": [
        "gsc"
      ],
      "match": "any",
      "conditions": [
        {
          "signal": "clicks_drop",
          "operator": "gte",
          "value": 20,
          "minImpressions": 150
        }
      ],
      "lookbackDays": 28,
      "compareDays": 28,
      "pollHours": 24,
      "cooldownHours": 72,
      "maxUrls": 5
    }
  },
  "actionBlock": {
    "keyword": "content-optimizer-full",
    "executionKind": "content_optimizer",
    "executionPayload": {
      "targetBucket": "posts",
      "updateMode": "update"
    },
    "title": "Refresh blog posts on clicks drop"
  },
  "isAutomation": true,
  "kind": "template"
}
