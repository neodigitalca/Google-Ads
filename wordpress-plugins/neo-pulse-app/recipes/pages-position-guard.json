{
  "keyword": "pages-position-guard",
  "name": "Pages Position Guard",
  "description": "Meta and extra text on static pages when average ranking position worsens.",
  "notes": [
    "Polls Google Search Console every 24 hours.",
    "Scope: static pages (services, about, landing pages).",
    "Runs when average ranking position worsened by at least 3 spots, with at least 100 impressions.",
    "Updates title, meta description, and SEO extra text. Page body content is not rewritten.",
    "Same URL waits 72 hours before it can run again."
  ],
  "category": "reactive",
  "verticals": [
    "general"
  ],
  "tags": [
    "gsc",
    "pages",
    "position",
    "meta"
  ],
  "prerequisites": [
    "gsc",
    "wordpress"
  ],
  "filters": {
    "executionKinds": [
      "content_optimizer_meta"
    ],
    "targetBuckets": [
      "pages"
    ],
    "triggerSignals": [
      "position_drop"
    ],
    "actionCount": 1
  },
  "defaultTasks": [
    {
      "keyword": "pages-position",
      "title": "Meta + extra text on pages when position drops",
      "status": "todo",
      "assignPulse": true,
      "scheduleMode": "trigger",
      "executionKind": "content_optimizer_meta",
      "executionPayload": {
        "targetBucket": "pages",
        "updateMode": "update"
      },
      "triggerConfig": {
        "sources": [
          "gsc"
        ],
        "match": "any",
        "conditions": [
          {
            "signal": "position_drop",
            "operator": "gte",
            "value": 3,
            "minImpressions": 100
          }
        ],
        "lookbackDays": 28,
        "compareDays": 28,
        "pollHours": 24,
        "cooldownHours": 72,
        "maxUrls": 5
      }
    }
  ],
  "triggerBlock": {
    "keyword": "gsc-position-drop",
    "kind": "gsc",
    "source": "gsc",
    "targetBucket": "pages",
    "triggerConfig": {
      "sources": [
        "gsc"
      ],
      "match": "any",
      "conditions": [
        {
          "signal": "position_drop",
          "operator": "gte",
          "value": 3,
          "minImpressions": 100
        }
      ],
      "lookbackDays": 28,
      "compareDays": 28,
      "pollHours": 24,
      "cooldownHours": 72,
      "maxUrls": 5
    }
  },
  "actionBlock": {
    "keyword": "content-optimizer-meta",
    "executionKind": "content_optimizer_meta",
    "executionPayload": {
      "targetBucket": "pages",
      "updateMode": "update"
    },
    "title": "Meta + extra text on pages when position drops"
  },
  "isAutomation": true,
  "kind": "template"
}
