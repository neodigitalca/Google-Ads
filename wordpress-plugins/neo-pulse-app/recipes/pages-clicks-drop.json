{
  "keyword": "pages-clicks-drop",
  "name": "Pages Clicks Drop",
  "description": "Meta and extra text on static pages when total search clicks fall.",
  "notes": [
    "Polls Google Search Console every 24 hours.",
    "Scope: static pages (Pages bucket).",
    "Runs when total clicks from google search fell at least 15% vs the prior 28 days, with at least 100 impressions.",
    "Updates title, meta description, and SEO extra text. Page body content is not rewritten.",
    "Same URL waits 72 hours before it can run again."
  ],
  "category": "reactive",
  "verticals": [
    "general"
  ],
  "tags": [
    "gsc",
    "pages",
    "clicks",
    "meta"
  ],
  "prerequisites": [
    "gsc",
    "wordpress"
  ],
  "filters": {
    "executionKinds": [
      "content_optimizer_meta"
    ],
    "targetBuckets": [
      "pages"
    ],
    "triggerSignals": [
      "clicks_drop"
    ],
    "actionCount": 1
  },
  "defaultTasks": [
    {
      "keyword": "pages-clicks",
      "title": "Meta + extra text on pages on clicks drop",
      "status": "todo",
      "assignPulse": true,
      "scheduleMode": "trigger",
      "executionKind": "content_optimizer_meta",
      "executionPayload": {
        "targetBucket": "pages",
        "updateMode": "update"
      },
      "triggerConfig": {
        "sources": [
          "gsc"
        ],
        "match": "any",
        "conditions": [
          {
            "signal": "clicks_drop",
            "operator": "gte",
            "value": 15,
            "minImpressions": 100
          }
        ],
        "lookbackDays": 28,
        "compareDays": 28,
        "pollHours": 24,
        "cooldownHours": 72,
        "maxUrls": 5
      }
    }
  ],
  "triggerBlock": {
    "keyword": "gsc-clicks-drop",
    "kind": "gsc",
    "source": "gsc",
    "targetBucket": "pages",
    "triggerConfig": {
      "sources": [
        "gsc"
      ],
      "match": "any",
      "conditions": [
        {
          "signal": "clicks_drop",
          "operator": "gte",
          "value": 15,
          "minImpressions": 100
        }
      ],
      "lookbackDays": 28,
      "compareDays": 28,
      "pollHours": 24,
      "cooldownHours": 72,
      "maxUrls": 5
    }
  },
  "actionBlock": {
    "keyword": "content-optimizer-meta",
    "executionKind": "content_optimizer_meta",
    "executionPayload": {
      "targetBucket": "pages",
      "updateMode": "update"
    },
    "title": "Meta + extra text on pages on clicks drop"
  },
  "isAutomation": true,
  "kind": "template"
}
