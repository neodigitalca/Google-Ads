{
  "keyword": "posts-position-recovery",
  "name": "Posts Position Recovery",
  "description": "Full AISEO on blog posts when average ranking position worsens.",
  "notes": [
    "Polls Google Search Console every 24 hours.",
    "Scope: blog posts (Posts bucket).",
    "Runs when average ranking position worsened by at least 3 spots, with at least 100 impressions.",
    "NEO Pulse rewrites the full post to compete for the keyword again.",
    "Same URL waits 72 hours before it can run again."
  ],
  "category": "reactive",
  "verticals": [
    "editorial",
    "general"
  ],
  "tags": [
    "gsc",
    "posts",
    "position"
  ],
  "prerequisites": [
    "gsc",
    "wordpress"
  ],
  "filters": {
    "executionKinds": [
      "content_optimizer"
    ],
    "targetBuckets": [
      "posts"
    ],
    "triggerSignals": [
      "position_drop"
    ],
    "actionCount": 1
  },
  "defaultTasks": [
    {
      "keyword": "posts-position",
      "title": "Full AISEO on posts when position drops",
      "status": "todo",
      "assignPulse": true,
      "scheduleMode": "trigger",
      "executionKind": "content_optimizer",
      "executionPayload": {
        "targetBucket": "posts",
        "updateMode": "update"
      },
      "triggerConfig": {
        "sources": [
          "gsc"
        ],
        "match": "any",
        "conditions": [
          {
            "signal": "position_drop",
            "operator": "gte",
            "value": 3,
            "minImpressions": 100
          }
        ],
        "lookbackDays": 28,
        "compareDays": 28,
        "pollHours": 24,
        "cooldownHours": 72,
        "maxUrls": 5
      }
    }
  ],
  "triggerBlock": {
    "keyword": "gsc-position-drop",
    "kind": "gsc",
    "source": "gsc",
    "targetBucket": "posts",
    "triggerConfig": {
      "sources": [
        "gsc"
      ],
      "match": "any",
      "conditions": [
        {
          "signal": "position_drop",
          "operator": "gte",
          "value": 3,
          "minImpressions": 100
        }
      ],
      "lookbackDays": 28,
      "compareDays": 28,
      "pollHours": 24,
      "cooldownHours": 72,
      "maxUrls": 5
    }
  },
  "actionBlock": {
    "keyword": "content-optimizer-full",
    "executionKind": "content_optimizer",
    "executionPayload": {
      "targetBucket": "posts",
      "updateMode": "update"
    },
    "title": "Full AISEO on posts when position drops"
  },
  "isAutomation": true,
  "kind": "template"
}
