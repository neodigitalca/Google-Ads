{
  "keyword": "pages-meta-first",
  "name": "Pages Meta First",
  "description": "Meta and extra text upkeep on pages when ranking or click-through rate slips.",
  "notes": [
    "Polls Google Search Console every 24 hours.",
    "Scope: static pages (Pages bucket).",
    "Runs when average ranking position worsened by at least 3 spots, with at least 100 impressions. OR when click-through rate fell at least 10% vs the prior 28 days (similar visibility, fewer clicks), with at least 100 impressions.",
    "Updates title, meta description, and SEO extra text. Page body content is not rewritten.",
    "Same URL waits 72 hours before it can run again."
  ],
  "category": "maintenance",
  "verticals": [
    "general"
  ],
  "tags": [
    "gsc",
    "pages",
    "meta"
  ],
  "prerequisites": [
    "gsc",
    "wordpress"
  ],
  "filters": {
    "executionKinds": [
      "content_optimizer_meta"
    ],
    "targetBuckets": [
      "pages"
    ],
    "triggerSignals": [
      "position_drop",
      "ctr_drop"
    ],
    "actionCount": 1
  },
  "defaultTasks": [
    {
      "keyword": "pages-meta",
      "title": "Meta optimize pages on position or CTR drop",
      "status": "todo",
      "assignPulse": true,
      "scheduleMode": "trigger",
      "executionKind": "content_optimizer_meta",
      "executionPayload": {
        "targetBucket": "pages",
        "updateMode": "update"
      },
      "triggerConfig": {
        "sources": [
          "gsc"
        ],
        "match": "any",
        "conditions": [
          {
            "signal": "position_drop",
            "operator": "gte",
            "value": 3,
            "minImpressions": 100
          },
          {
            "signal": "ctr_drop",
            "operator": "gte",
            "value": 10,
            "minImpressions": 100
          }
        ],
        "lookbackDays": 28,
        "compareDays": 28,
        "pollHours": 24,
        "cooldownHours": 72,
        "maxUrls": 5
      }
    }
  ],
  "triggerBlock": {
    "keyword": "gsc-position-drop",
    "kind": "gsc",
    "source": "gsc",
    "targetBucket": "pages",
    "triggerConfig": {
      "sources": [
        "gsc"
      ],
      "match": "any",
      "conditions": [
        {
          "signal": "position_drop",
          "operator": "gte",
          "value": 3,
          "minImpressions": 100
        },
        {
          "signal": "ctr_drop",
          "operator": "gte",
          "value": 10,
          "minImpressions": 100
        }
      ],
      "lookbackDays": 28,
      "compareDays": 28,
      "pollHours": 24,
      "cooldownHours": 72,
      "maxUrls": 5
    }
  },
  "actionBlock": {
    "keyword": "content-optimizer-meta",
    "executionKind": "content_optimizer_meta",
    "executionPayload": {
      "targetBucket": "pages",
      "updateMode": "update"
    },
    "title": "Meta optimize pages on position or CTR drop"
  },
  "isAutomation": true,
  "kind": "template"
}
