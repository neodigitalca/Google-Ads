<IfModule mod_rewrite.c>
RewriteEngine On

# Mobile latest-version entry redirect
RewriteCond %{QUERY_STRING} !(^|&)v=20260816015625580(&|$)
RewriteRule ^mobile/?(?:index\.html)?$ /mobile/?v=20260816015625580 [R=302,L]

# App latest-version entry redirect
RewriteCond %{QUERY_STRING} !(^|&)v=20260903162826678(&|$)
RewriteRule ^app/?(?:index\.html)?$ /app/?v=20260903162826678 [R=302,L]

# SPA static bypass (WordPress must not swallow asset requests)
