# NEO Pulse WP secrets — copy to .env and fill in ( .env is gitignored )
#
# Or run: npm run embed:neo-pulse-wp-secrets (copies from repo root .env before deploy)

# OpenRouter — AI generation, chat demo, editor wands
NEO_PULSE_WP_OPENROUTER_API_KEY=

# DataForSEO — keyword research (login + API password from dataforseo.com)
NEO_PULSE_WP_DATAFORSEO_LOGIN=
NEO_PULSE_WP_DATAFORSEO_PASSWORD=

# AgentMail — Flo inbox and per-site email (keys from console.agentmail.to)
NEO_PULSE_WP_AGENTMAIL_API_KEY=
NEO_PULSE_WP_AGENTMAIL_INBOX=

# Semrush — optional SEO research
NEO_PULSE_WP_SEMRUSH_API_KEY=

# Chekkit — Events webhook URL (Settings → Connections → Events webhook in Chekkit)
# Default hub: https://neodigital.ca/webhook (also set in Chat → General unless overridden here)
NEO_PULSE_WP_CHEKKIT_WEBHOOK_URL=
