{
  "meta": {
    "preset": "disable",
    "label": "Disable Speed (diagnostic)",
    "description": "Turns off the Speed buffer completely. Use to confirm whether NEO Pulse Speed is involved in layout issues."
  },
  "speed": {
    "enabled": false,
    "optimize_css": false,
    "optimize_js": false,
    "minify_html": false,
    "aggregate_css": false,
    "aggregate_js": false,
    "defer_js": false,
    "skip_logged_in": true,
    "cache_ttl": 604800,
    "remove_query_strings": false,
    "js_exclude": "",
    "css_exclude": "",
    "imported_autoptimize": true
  }
}
