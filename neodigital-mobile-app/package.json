{
  "name": "neodigital-mobile-app",
  "version": "1.0.0",
  "private": true,
  "description": "NEO Pulse Android shell — loads neodigital.ca/mobile in Capacitor WebView",
  "scripts": {
    "sync": "cap sync android",
    "open:android": "cap open android",
    "build:android": "cap sync android && cd android && gradlew.bat assembleDebug",
    "assets:generate": "capacitor-assets generate --android --iconBackgroundColor \"#000000\" --iconBackgroundColorDark \"#000000\" --splashBackgroundColor \"#000000\" --splashBackgroundColorDark \"#000000\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.8.2"
  }
}
